expenses = []

def add_expense():
    try: 
        name = input("Enter expense name: ").strip()
        if name == "":
            print(" Expense name cannot be empty")
            return

        amount = float(input("Enter amount: "))
        if amount <= 0:  
            print(" Amount must be greater than 0")
            return

        category = input("Enter category: ").strip()
        if category == "":
            print(" Category cannot be empty")
            return

        expenses.append({
            "name": name,
            "amount": amount,    
            "category": category
        })

        print(" Expense added!")

    except ValueError:
        print(" Invalid amount. Enter numbers only.")


def show_expenses():
    if not expenses:
        print("No expenses recorded.")
        return

    print("\n--- Expenses ---")
    for i, exp in enumerate(expenses, 1):
        print(f"{i}. {exp['name']} | ₹{exp['amount']} | {exp['category']}")


def total_expense():
    total = sum(exp["amount"] for exp in expenses)
    print(" Total:", total)


while True:
    print("\n====== Expense Tracker ======")
    print("1. Add Expense")
    print("2. View Expenses")
    print("3. Show Total")
    print("4. Exit")

    choice = input("Choose (1-4): ")

    if choice == "1":
        add_expense()
    elif choice == "2":
        show_expenses()
    elif choice == "3":
        total_expense()
    elif choice == "4":
        print("Goodbye ")
        break
    else:
        print(" Invalid choice")
